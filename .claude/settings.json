{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-branches.js",
            "timeout": 10,
            "statusMessage": "브랜치 보호 규칙 확인 중..."
          }
        ]
      }
    ]
  }
}
