[Desktop Entry]
Type=Application
Version=1.0
Name=TerraByte 게이트웨이 상태판
Name[en]=TerraByte Gateway Dashboard
Comment=화분과 게이트웨이 상태를 전체화면으로 표시합니다
# The board is served by the bridge (`terrabyte_edge status`); this only opens a
# browser at it. Chromium is tried first because that is what the Pi images ship;
# xdg-open covers everything else.
Exec=sh -c "sleep 8; chromium-browser --kiosk --noerrdialogs --disable-infobars http://127.0.0.1:8090 || chromium --kiosk http://127.0.0.1:8090 || xdg-open http://127.0.0.1:8090"
Terminal=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
