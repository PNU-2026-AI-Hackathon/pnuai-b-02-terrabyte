# Prefer a stable symlink from /dev/serial/by-id over /dev/ttyACM0.
TB_SERIAL_PORT=/dev/serial/by-id/usb-Arduino_example-if00
TB_SERIAL_BAUD=115200

TB_DEVICE_ID=replace-with-provisioned-gateway-id
TB_EXPECTED_NODE_ID=replace-with-provisioned-arduino-node-id

TB_CROP_CONTEXT_ID=replace-with-active-crop-context-id
TB_CLOCK_MINIMUM_UTC=2025-01-01T00:00:00Z
TB_DATABASE_PATH=/var/lib/terrabyte-edge/outbox.sqlite3

# mqtt (default) or http. MQTT is the operational transport; http is the
# debug/fallback path (design doc §6.6, §8.1).
TB_TRANSPORT=mqtt

# --- MQTT transport (used when TB_TRANSPORT=mqtt) ---
TB_MQTT_HOST=mosquitto.example.com
TB_MQTT_PORT=1883
# Provisioned per gateway alongside TB_DEVICE_ID; see mosquitto password file.
TB_MQTT_USERNAME=gw-replace-with-provisioned-gateway-id
TB_MQTT_PASSWORD=replace-with-provisioned-mqtt-password
TB_MQTT_TLS=false
TB_MQTT_TOPIC_PREFIX=tb/v2
TB_MQTT_KEEPALIVE_SECONDS=30
TB_MQTT_PUBLISH_TIMEOUT_SECONDS=10

# --- HTTP transport (used only when TB_TRANSPORT=http) ---
# Do not put the token in this environment file. Store it in the root-owned file.
#TB_DEVICE_TOKEN_FILE=/etc/terrabyte-edge.token
#TB_BACKEND_BASE_URL=https://api.example.com
#TB_HTTP_TIMEOUT_SECONDS=10

TB_UPLOAD_BATCH_SIZE=20
TB_OUTBOX_MAX_ROWS=100000
TB_UPLOAD_INTERVAL_SECONDS=2
TB_RETRY_BASE_SECONDS=2
TB_RETRY_MAX_SECONDS=300
TB_LOG_LEVEL=INFO
