  "decision_change": {
    "previous_contract": "근거가 충분한 축만 상태와 거리를 제공하고 생육환경 점수를 만들지 않는다.",
    "new_contract": "사용자 결정에 따라 완전히 보정된 세 축 입력을 전제로 8개 작물의 0-100 생육환경 적합도 점수를 계산한다.",
    "reason": "사용자가 검증 근거가 부족한 축에는 일반 대분류 기본값을 사용하는 것을 허용했고, 이번 변경에서는 센서값이 완전히 보정되어 있다고 명시했다.",
    "scope": "작물 생육용 대기온도, 상대습도, 식물광 PPFD 세 축만 점수에 포함한다. 미세먼지·소음·병해 조건은 종합점수에 포함하지 않는다."
  },

  "read_this_first": {
    "headline": "crop_environment_observation에 완전 보정된 세 값을 넣으면 DB 뷰가 축별 점수와 종합점수를 결정적으로 계산한다.",
    "source_of_truth": "점수 경계·가중치·근거 등급의 단일 진실 공급원은 crop_score_profile이다.",
    "important_boundary": "점수 API와 DB에는 lux를 직접 넣지 않는다. 완전 보정 가정은 lux가 이미 PPFD로 변환된 뒤 canonical 입력에 들어온다는 뜻이다.",
    "verification": "python backend/db/smoke_test.py"
  },

  "perfect_input_assumption": {
    "contract_id": "perfect_calibrated_v1",
    "guarantees": [
      "대기온도는 작물 관부 높이의 섭씨온도다.",
      "상대습도는 같은 시각·같은 미기후 지점의 0-100% 값이다.",
      "식물광은 관부 수평면의 400-700 nm PPFD이며 단위는 umol_m-2_s-1이다.",
      "센서 교정, lux-to-PPFD 변환, 이상치 제거, 단위변환과 품질검사는 입력 전에 끝났다.",
      "세 축은 같은 context_id와 captured_at_utc의 환경을 나타낸다."
    ],
    "not_part_of_scoring_path": [
      "센서 정확도 추정",
      "교정 오차 전파",
      "결측 보간",
      "raw lux의 광원별 변환",
      "서로 다른 시각의 센서값 결합"
    ],
    "failure_policy": "세 축 중 하나라도 없거나 canonical 제약을 위반하면 관측 행과 점수를 만들지 않는다. 결측을 0점으로 바꾸지 않는다."
  },

  "score_semantics": {
    "name_ko": "현재 생육환경 적합도",
    "range": [0, 100],
    "meaning": "선택한 작물 프로필의 온도·상대습도·PPFD 목표 구간에 현재 환경이 얼마나 가까운지를 나타내는 제품 휴리스틱",
    "does_not_mean": [
      "작물 생존 확률",
      "예상 수확량 또는 품질",
      "병해 발생 확률",
      "사람 건강 또는 법적 안전도",
      "품종·생육단계가 다른 모든 재배의 보편 최적도"
    ],
    "snapshot_rule": "현재 PPFD를 사용하는 순간 점수다. 하루 전체 광량 적합도를 의미하지 않는다.",
    "future_daily_extension": "일간 점수가 필요하면 동일한 버전 규칙으로 DLI 전용 프로필과 일간 관측 테이블을 별도 추가한다."
  },

  "canonical_input_contract": {
    "database_table": "crop_environment_observation",
    "required_fields": {
      "context_id": "crop_context.context_id",
      "captured_at_utc": "ISO-8601 UTC timestamp",
      "air_temperature_c": "REAL, -50..80",
      "relative_humidity_pct": "REAL, 0..100",
      "ppfd_umol_m2_s": "REAL, 0..5000",
      "input_contract": "literal perfect_calibrated_v1"
    },
    "database_guards": [
      "context_id는 존재해야 한다.",
      "captured_at_utc는 crop_context의 [valid_from_utc, valid_to_utc) 구간 안이어야 한다.",
      "같은 context_id와 captured_at_utc 조합은 한 번만 저장한다.",
      "세 물리값은 모두 NOT NULL이다.",
      "crop_context의 crop과 score_profile_id는 복합 외래키로 일치해야 한다."
    ],
    "prohibited_fields": [
      "illuminance_lx",
      "quality_estimate",
      "missing_axis_default",
      "client_supplied_score",
      "client_supplied_grade"
    ]
  },

