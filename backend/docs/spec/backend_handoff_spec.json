  "axis_score_algorithm": {
    "database_view": "crop_environment_axis_score",
    "function": "trapezoid",
    "pseudocode": [
      "if x <= zero_low or x >= zero_high: score = 0",
      "else if x < optimal_low: score = 100 * (x-zero_low)/(optimal_low-zero_low)",
      "else if x <= optimal_high: score = 100",
      "else: score = 100 * (zero_high-x)/(zero_high-optimal_high)",
      "round score to one decimal place"
    ],
    "outputs": [
      "temperature_score",
      "humidity_score",
      "plant_light_score"
    ],
    "determinism": "프로필 버전과 canonical 입력이 같으면 DB와 모든 API 구현은 같은 점수를 반환해야 한다."
  },

  "overall_score_algorithm": {
    "database_view": "crop_environment_score",
    "method": "weighted_geometric_mean",
    "zero_rule": "세 축 중 하나가 0점이면 overall_score도 0점이다.",
    "formula": "100 * product((axis_score/100)^(axis_exponent/sum_exponents)); 현재 지수 1/1/1은 각각 1/3으로 정규화",
    "rounding": "최종값을 소수점 첫째 자리로 반올림",
    "grade_bands": [
      {"min_inclusive": 80, "max_inclusive": 100, "grade": "GOOD"},
      {"min_inclusive": 60, "max_exclusive": 80, "grade": "NORMAL"},
      {"min_inclusive": 0, "max_exclusive": 60, "grade": "BAD"}
    ],
    "model_policy": "현재는 equal_geometric_v1 + 1/1/1만 활성화한다. 작물별 지수는 결과 데이터 검증 후 새 프로필 버전으로만 배포한다."
  },

  "database_contract": {
    "objects": [
      {"name": "crop_score_profile", "kind": "table", "purpose": "버전형 점수 경계·가중치·근거 등급"},
      {"name": "crop_score_profile_activation", "kind": "table", "purpose": "작물별 신규 컨텍스트 기본 프로필"},
      {"name": "crop_score_model_config", "kind": "table", "purpose": "프로필별 불변 집계 모델·지수·곡선 패밀리"},
      {"name": "crop_context.score_profile_id", "kind": "foreign_key", "purpose": "컨텍스트와 정확한 프로필 버전 고정"},
      {"name": "crop_environment_observation", "kind": "table", "purpose": "완전 보정 세 축 canonical 입력"},
      {"name": "crop_environment_axis_score", "kind": "view", "purpose": "사다리꼴 축별 점수"},
      {"name": "crop_environment_score", "kind": "view", "purpose": "프로필 설정 기반 가중 기하평균 종합점수와 등급"},
      {"name": "latest_crop_environment_score", "kind": "view", "purpose": "컨텍스트별 최신 점수"},
      {"name": "legacy_lux_ingestion_status", "kind": "view", "purpose": "기존 BH1750 교정 파이프라인 진단; 점수 가용성 판정에 사용 금지"}
    ],
    "write_flow": [
      "crop_code의 활성 profile_id를 조회한다.",
      "crop_context를 만들면서 score_profile_id를 고정한다.",
      "수집 계층이 세 값을 canonical 단위로 보정하고 검증한다.",
      "한 트랜잭션에서 crop_environment_observation 한 행을 INSERT한다.",
      "environment_observation_id로 crop_environment_score를 조회해 응답한다."
    ],
    "unchanged_layers": [
      "evidence_document 및 corpus_* 근거 테이블",
      "raw sensor 관측 테이블",
      "PM·소음 참조 및 관측 테이블",
      "바질 병해 조건 테이블"
    ]
  },

  "api_contract": {
    "framework": "백엔드 프레임워크는 구현자 재량이며 JSON 필드명과 상태코드는 이 계약을 따른다.",
    "endpoints": [
      {
        "method": "GET",
        "path": "/api/crop-score-profiles",
        "returns": "8개 활성 프로필의 경계, 가중치, photoperiod, 축별 evidenceGrade"
      },
      {
        "method": "POST",
        "path": "/api/crop-contexts/{contextId}/environment-observations",
        "request_body": {
          "capturedAtUtc": "2026-07-16T05:00:00Z",
          "airTemperatureC": 27.0,
          "relativeHumidityPct": 60.0,
          "ppfdUmolM2S": 400.0,
          "inputContract": "perfect_calibrated_v1"
        },
        "success_status": 201,
        "returns": "저장된 관측 ID와 해당 시점의 전체 점수 응답"
      },
      {
        "method": "GET",
        "path": "/api/crop-contexts/{contextId}/score/latest",
        "example_response": {
          "contextId": "ctx-basil-01",
          "zoneId": "zone-01",
          "crop": "basil",
          "profile": {"id": "basil-general-v2", "version": "2.0.0"},
          "capturedAtUtc": "2026-07-16T05:00:00Z",
          "reading": {
            "airTemperatureC": 27.0,
            "relativeHumidityPct": 60.0,
            "ppfdUmolM2S": 400.0,
            "referencePhotoperiodH": 16
          },
          "scores": {
            "temperature": 100.0,
            "humidity": 100.0,
            "plantLight": 100.0,
            "overall": 100.0,
            "grade": "GOOD"
          },
          "evidenceGrade": {
            "temperature": "A",
            "humidity": "C",
            "plantLight": "A"
          },
          "disclaimerKo": "현재 세 환경축의 프로필 적합도이며 생존율·수확량·병해 확률이 아닙니다."
        }
      },
      {
        "method": "GET",
        "path": "/api/zones/{zoneId}/crop-scores",
        "returns": "해당 zone의 활성 crop_context별 최신 점수 목록"
      }
    ],
    "errors": [
      {"status": 400, "code": "INVALID_CANONICAL_VALUE", "when": "단위·범위·inputContract 위반"},
      {"status": 404, "code": "CROP_CONTEXT_NOT_FOUND", "when": "contextId가 없음"},
      {"status": 404, "code": "SCORE_NOT_FOUND", "when": "유효한 완전 입력이 한 번도 없음"},
      {"status": 409, "code": "DUPLICATE_OBSERVATION", "when": "같은 contextId와 capturedAtUtc가 이미 존재"},
      {"status": 409, "code": "CONTEXT_OUT_OF_WINDOW", "when": "관측시각이 컨텍스트 유효기간 밖"},
      {"status": 422, "code": "INCOMPLETE_AXES", "when": "온도·RH·PPFD 중 하나라도 누락"},
      {"status": 422, "code": "PROFILE_CROP_MISMATCH", "when": "crop과 scoreProfileId가 일치하지 않음"}
    ],
    "forbidden_behavior": [
      "클라이언트가 보낸 score나 grade를 저장 또는 반환",
      "누락된 축을 0으로 채워 점수 생성",
      "raw lux를 crop_score_profile.ppfd 경계와 직접 비교",
      "PM·소음·병해 경고를 overall_score에 합산",
      "evidence grade C를 A처럼 숨겨서 표시"
    ]
  },

