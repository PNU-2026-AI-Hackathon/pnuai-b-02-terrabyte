# syntax=docker/dockerfile:1.7
#
# 개발용 프론트엔드(Expo) 이미지.
# node 이미지 태그 하나로 node · npm · npx 버전이 함께 고정된다.
ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE}

ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    EXPO_NO_TELEMETRY=1 \
    LANG=C.UTF-8

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends git curl tini; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /workspace/app; \
    chown -R node:node /workspace

WORKDIR /workspace/app

# 의존성을 이미지에 미리 설치해 두면, 최초 실행 시 node_modules 볼륨이
# 이미지 내용으로 채워지므로 `npm ci` 를 기다리지 않아도 된다.
COPY --chown=node:node package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci && chown -R node:node /workspace/app/node_modules

COPY docker-entrypoint-dev.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER node
EXPOSE 8081 6006

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["npx", "expo", "start", "--web", "--port", "8081"]
