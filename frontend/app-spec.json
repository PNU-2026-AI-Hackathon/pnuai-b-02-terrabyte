      ]
    },
    "latest": [
      { "label": "온도", "emoji": "🌡️", "value": "24.5℃", "sub": "최적 범위 (20~26℃)" },
      { "label": "습도", "emoji": "💧", "value": "45%", "sub": "최적 대비 15% 부족" },
      { "label": "조도", "emoji": "☀️", "value": "8,000 lux", "sub": "최적 대비 7,000 lux 부족" },
      { "label": "토양수분", "emoji": "🪴", "value": "38%", "sub": "최적 범위 (30~45%)" }
    ]
  },
  "scoreLogic": {
    "note": "Placeholder — final formula TBD. Prototype hardcodes 68.",
    "suggested": "For each factor, score 100 when current ∈ [optimalMin, optimalMax], decaying linearly toward 0 at axis bounds. Overall = weighted average across factors. Grades: <60 나쁨, 60–79 보통, 80+ 좋음."
  },
  "openQuestions": [
    "Score formula and per-factor weights",
    "Recommendation engine spec (rule-based vs ML)",
    "Live product catalog, inventory, cart persistence, checkout, and payment integration",
    "Time-series API contract and sampling per range",
    "Auth backend and validation rules",
    "Multi-device / multi-pot support"
  ]
}
